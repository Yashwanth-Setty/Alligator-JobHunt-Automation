# Alligator Apply — API & integrations (copy to .env, never commit)

PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./backend/data/alligator.db
RESUMES_DIR=./backend/uploads/resumes

# Demo mode — adapters read mock_jobs.json instead of live APIs (recommended for portfolio demo)
MOCK_MODE=true

# Enabled job sources (comma-separated). Workday is opt-in:
# JOB_SOURCES=greenhouse,lever,ashby,smartrecruiters,workday
JOB_SOURCES=greenhouse,lever,ashby,smartrecruiters

# Job source scan limits
SOURCE_TIMEOUT_MS=12000
MAX_RESULTS_PER_SOURCE=50
MAX_COMPANIES_PER_SOURCE=10
MAX_TOTAL_RESULTS=200
COMPANY_CONCURRENCY=3

# Scan performance
FAST_SCAN=false
GREENHOUSE_FETCH_CONTENT=false
SOURCE_CACHE_TTL_MINUTES=30

# Live mode company/board targets (override data/source_targets.json)
# GREENHOUSE_BOARDS=stripe,airbnb
# LEVER_COMPANIES=spotify,palantir
# ASHBY_BOARDS=Ashby
# SMARTRECRUITERS_COMPANIES=SmartRecruiters
# SOURCE_TARGETS_PATH=./backend/data/source_targets.json

# Playwright auto-apply safety
AUTO_SUBMIT=false

# OpenAI (job scoring — future milestone)
OPENAI_API_KEY=your_openai_key_here

# IBM watsonx (agent reasoning — placeholder)
WATSONX_API_KEY=your_watsonx_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Optional integrations
APIFY_TOKEN_1=your_apify_token_here
TAVILY_API_KEY=your_tavily_key_here
