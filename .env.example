# Alligator Job Hunt Automation — copy to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# Path to your resume PDF (required for scoring and apply agent)
APPLICANT_RESUME_PATH=./resumes/your_resume.pdf

# ── Job filtering ──────────────────────────────────────────────
USA_ONLY=true
COUNTRY_FILTER=US

# ── Applicant profile (Playwright autofill) ────────────────────
APPLICANT_FULL_NAME=Your Full Name
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=
APPLICANT_ADDRESS=
APPLICANT_CITY=
APPLICANT_STATE=
APPLICANT_ZIP=
APPLICANT_LINKEDIN=
APPLICANT_GITHUB=

# ── Optional integrations ──────────────────────────────────────
ENABLE_DESKTOP_NOTIFICATIONS=true
ENABLE_LINKEDIN=false
ENABLE_GMAIL_SYNC=false

# Apify — LinkedIn scraping (optional)
APIFY_TOKEN_1=your_apify_token_here

# Tavily — job liveness checks (optional)
TAVILY_API_KEY=your_tavily_key_here

# Brave Search — MCP (optional)
BRAVE_API_KEY=your_brave_key_here

# Google Sheets — accountability audit (optional)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Career-ops pipeline injection (optional)
CAREER_OPS_PATH=./data/pipeline.md
